local urls = {
    "https://raw.githubusercontent.com/Memito89/TheUltimateStealABrainrotPackageOfScripts/refs/heads/main/Dex%20Finder.lua",
    "https://raw.githubusercontent.com/Memito89/TheUltimateStealABrainrotPackageOfScripts/refs/heads/main/Ikura%20Hub"
}

-- Download both scripts concurrently first
for _, url in ipairs(urls) do
    task.spawn(function()
        local success, code = pcall(function()
            return game:HttpGetAsync(url)
        end)
        
        if success and code then
            local func, err = loadstring(code)
            if func then
                task.spawn(func) -- Execute immediately upon download complete
            else
                warn("Failed to compile code from: " .. url .. "\nError: " .. tostring(err))
            end
        else
            warn("Failed to download script from: " .. url)
        end
    end)
end
